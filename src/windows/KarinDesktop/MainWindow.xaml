<Window x:Class="KarinDesktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="KARIN AI Desktop" Width="1500" Height="920" MinWidth="1180" MinHeight="720"
 WindowStartupLocation="CenterScreen" Background="#041019" Foreground="#F5FCFF"
 FontFamily="Segoe UI" WindowStyle="None" ResizeMode="CanResize">
 <Window.Resources>
  <LinearGradientBrush x:Key="AppBackground" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#031019" Offset="0"/>
   <GradientStop Color="#071A28" Offset=".52"/>
   <GradientStop Color="#03131D" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="IceGradient" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#D9F8FF" Offset="0"/>
   <GradientStop Color="#72DCFF" Offset=".48"/>
   <GradientStop Color="#4AA9FF" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="Ice" Color="#C9F5FF"/>
  <SolidColorBrush x:Key="IceBlue" Color="#75DEFF"/>
  <SolidColorBrush x:Key="Muted" Color="#83A8B8"/>
  <SolidColorBrush x:Key="Panel" Color="#C70A1D2A"/>
  <SolidColorBrush x:Key="Panel2" Color="#D10D2636"/>
  <SolidColorBrush x:Key="Stroke" Color="#503D9FC2"/>

  <Style x:Key="Glass" TargetType="Border">
   <Setter Property="Background" Value="{StaticResource Panel}"/>
   <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="18"/>
  </Style>

  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background" Value="#B20D2432"/>
   <Setter Property="BorderBrush" Value="#3A75C7E8"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="15"/>
   <Setter Property="Padding" Value="14"/>
  </Style>

  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#EAFBFF"/>
   <Setter Property="Background" Value="#191A4E63"/>
   <Setter Property="BorderBrush" Value="#536FDFFF"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="16,11"/>
   <Setter Property="Margin" Value="4"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
       BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="#304EA7C5"/>
        <Setter TargetName="Bd" Property="BorderBrush" Value="#A8EDFF"/>
       </Trigger>
       <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Bd" Property="Opacity" Value=".72"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="FontSize" Value="14"/>
   <Setter Property="Padding" Value="15,13"/>
  </Style>

  <Style TargetType="TextBox">
   <Setter Property="Foreground" Value="#EAFBFF"/>
   <Setter Property="Background" Value="#9A071B28"/>
   <Setter Property="BorderBrush" Value="#5A70DFFF"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="14,10"/>
   <Setter Property="FontSize" Value="15"/>
  </Style>
 </Window.Resources>

 <Border Background="{StaticResource AppBackground}" BorderBrush="#285A7380" BorderThickness="1">
  <Grid Margin="16">
   <Grid.RowDefinitions>
    <RowDefinition Height="76"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="105"/>
   </Grid.RowDefinitions>
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="245"/>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="305"/>
   </Grid.ColumnDefinitions>

   <!-- top -->
   <Border Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource Glass}" MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
    <Grid Margin="20,8">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Border Width="44" Height="44" CornerRadius="14" Background="#193F7085" BorderBrush="#8FEAFF" BorderThickness="1.5">
       <TextBlock Text="K" FontSize="24" FontWeight="Bold" Foreground="#C9F5FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
       <TextBlock Text="KARIN AI" FontSize="24" FontWeight="Bold"/>
       <TextBlock x:Name="ModeCaption" Text="Personal AI Desktop • Ice Blue" Foreground="{StaticResource Muted}" FontSize="12"/>
      </StackPanel>
      <Border Margin="22,0,0,0" CornerRadius="12" BorderBrush="#3D82B8D1" BorderThickness="1" Padding="10,5">
       <TextBlock x:Name="WakeBadge" Text="VOICE • OFF" Foreground="#9EDDEF"/>
      </Border>
      <Border Margin="8,0,0,0" CornerRadius="12" BorderBrush="#3D82B8D1" BorderThickness="1" Padding="10,5">
       <TextBlock x:Name="BridgeBadge" Text="ANDROID • OFFLINE" Foreground="#9EDDEF"/>
      </Border>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock x:Name="ClockText" Text="20:00:00" FontSize="18" Foreground="{StaticResource Ice}" VerticalAlignment="Center" Margin="0,0,14,0"/>
      <Button Content="—" Width="42" Height="38" Padding="0" Click="Minimize_Click"/>
      <Button Content="□" Width="42" Height="38" Padding="0" Click="Maximize_Click"/>
      <Button Content="×" Width="42" Height="38" Padding="0" Click="Close_Click"/>
     </StackPanel>
    </Grid>
   </Border>

   <!-- left navigation -->
   <Border Grid.Row="1" Grid.Column="0" Margin="0,12,12,12" Style="{StaticResource Glass}" Padding="12">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel>
      <TextBlock Text="KARIN SYSTEM" Foreground="#6EAEC6" FontSize="11" Margin="8,4,0,8"/>
      <Button Style="{StaticResource NavButton}" Content="✦   Home / AI Core" Click="Core_Click"/>
      <Button Style="{StaticResource NavButton}" Content="▦   Applications" Click="Apps_Click"/>
      <Button Style="{StaticResource NavButton}" Content="⌁   Documents" Click="Documents_Click"/>
      <Button Style="{StaticResource NavButton}" Content="◷   Routine Center" Click="Routine_Click"/>
      <Button Style="{StaticResource NavButton}" Content="↔   KARIN Link" Click="Android_Click"/>
      <Button Style="{StaticResource NavButton}" Content="⚙   Settings" Click="Settings_Click"/>
      <Separator Margin="4,14"/>
      <TextBlock Text="WORKSPACE" Foreground="#6EAEC6" FontSize="11" Margin="8,3,0,8"/>
      <Button x:Name="BusinessModeButton" Style="{StaticResource NavButton}" Content="◈   Enter Business Mode" Click="BusinessMode_Click"/>
     </StackPanel>

     <Border Grid.Row="2" Style="{StaticResource Card}">
      <StackPanel>
       <TextBlock Text="VOICE CORE" Foreground="#75DFFF" FontWeight="SemiBold"/>
       <TextBlock x:Name="VoiceNameText" Text="Female voice • auto-select" Foreground="#8CB3C3" FontSize="11" Margin="0,4,0,10"/>
       <Button x:Name="MicButton" Content="🎙  Activate wake word “Karin”" Click="Mic_Click"/>
       <TextBlock Text="Panggil “Karin”, lalu ucapkan perintah. Tidak lagi sekadar Speak Demo." TextWrapping="Wrap" Foreground="#7FA8B8" FontSize="11" Margin="5,8,5,2"/>
      </StackPanel>
     </Border>
    </Grid>
   </Border>

   <!-- center: default -->
   <Grid x:Name="PersonalModeGrid" Grid.Row="1" Grid.Column="1" Margin="0,12,12,12">
    <Grid.RowDefinitions><RowDefinition Height="1.2*"/><RowDefinition Height=".8*"/></Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource Glass}" Padding="20">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width=".9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>

      <Grid Grid.Column="0" Margin="8">
       <Ellipse Width="330" Height="330" Stroke="#245C7890" StrokeThickness="1" StrokeDashArray="3,6"/>
       <Ellipse Width="270" Height="270" Stroke="#55D2F4FF" StrokeThickness="1.4"/>
       <Ellipse Width="220" Height="220" Stroke="#8EEBFF" StrokeThickness="1.2" Opacity=".75"/>
       <Border x:Name="AvatarCore" Width="184" Height="184" CornerRadius="92" Background="#153B4E"
        BorderBrush="#BDEFFF" BorderThickness="2">
        <Border.Effect><DropShadowEffect Color="#65DFFF" BlurRadius="34" ShadowDepth="0" Opacity=".85"/></Border.Effect>
        <Grid>
         <Ellipse Width="150" Height="150" Fill="#173F53"/>
         <Path Fill="#BFF4FF" Data="M 48,75 C 55,40 80,24 104,28 C 127,31 146,50 150,76 C 139,63 126,56 115,54 C 91,67 67,69 48,75 Z"
          Stretch="Uniform" Width="122" Height="80" VerticalAlignment="Top" Margin="0,24,0,0"/>
         <Ellipse Width="12" Height="7" Fill="#E7FCFF" Margin="-48,14,0,0"/>
         <Ellipse Width="12" Height="7" Fill="#E7FCFF" Margin="48,14,0,0"/>
         <Border x:Name="Mouth" Width="34" Height="4" CornerRadius="6" Background="#E7FCFF" Margin="0,66,0,0"/>
        </Grid>
       </Border>
       <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,18">
        <TextBlock Text="KARIN" FontSize="29" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock x:Name="StatusText" Text="Ready • call me by saying “Karin”" Foreground="#8DB6C6" HorizontalAlignment="Center" Margin="0,5,0,0"/>
       </StackPanel>
      </Grid>

      <StackPanel Grid.Column="1" Margin="18,12,6,12">
       <TextBlock Text="Karin — AI Assistant" FontSize="25" FontWeight="Bold"/>
       <TextBlock Text="Halo Haikal, ada yang bisa aku bantu hari ini?" Foreground="#A6CDD9" FontSize="15" Margin="0,8,0,18"/>
       <WrapPanel>
        <Button Content="Buka Aplikasi" Click="Apps_Click"/>
        <Button Content="Cari Dokumen" Click="Documents_Click"/>
        <Button Content="Cek Sistem" Click="SystemStatus_Click"/>
        <Button Content="Pair Android" Click="Android_Click"/>
        <Button Content="Buat Pengingat" Click="Routine_Click"/>
        <Button Content="Mode Bisnis" Click="BusinessMode_Click"/>
       </WrapPanel>
       <Border Style="{StaticResource Card}" Margin="4,18,4,0">
        <StackPanel>
         <TextBlock Text="LIVE COMMAND" Foreground="#75DFFF" FontSize="11"/>
         <TextBlock Text="Kamu bisa mengetik atau cukup bicara. KARIN akan menjalankan fungsi yang tersedia di Windows, bukan tombol pajangan." TextWrapping="Wrap" Margin="0,6,0,10"/>
         <TextBlock x:Name="ListeningHint" Text="Voice idle" Foreground="#7FA9BA"/>
        </StackPanel>
       </Border>
      </StackPanel>
     </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="0,12,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border Grid.Column="0" Style="{StaticResource Glass}" Margin="0,0,8,0" Padding="15">
      <StackPanel>
       <TextBlock Text="RECENT / CONVERSATION" Foreground="#75DFFF" FontSize="11"/>
       <TextBox x:Name="HistoryBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Margin="-10,8,-10,-8"/>
      </StackPanel>
     </Border>
     <Border Grid.Column="1" Style="{StaticResource Glass}" Margin="4,0,8,0" Padding="15">
      <StackPanel>
       <TextBlock Text="ROUTINE TODAY" Foreground="#75DFFF" FontSize="11"/>
       <TextBlock Text="08:00  Start work" Margin="0,9,0,2"/>
       <TextBlock Text="12:00  Lunch" Margin="0,2"/>
       <TextBlock Text="15:30  Rest 15 min" Margin="0,2"/>
       <TextBlock Text="22:30  Stop computer" Margin="0,2"/>
       <TextBlock Text="23:00  Sleep" Margin="0,2"/>
       <Button Content="Open Routine Center" Click="Routine_Click" Margin="0,10,0,0"/>
      </StackPanel>
     </Border>
     <Border Grid.Column="2" Style="{StaticResource Glass}" Margin="4,0,0,0" Padding="15">
      <StackPanel>
       <TextBlock Text="KARIN LINK" Foreground="#75DFFF" FontSize="11"/>
       <TextBlock x:Name="PairInfo" Text="Android not paired" Foreground="#BFEFFF" TextWrapping="Wrap" Margin="0,8,0,6"/>
       <Button Content="Start PC ↔ Android Link" Click="StartBridge_Click"/>
       <TextBlock Text="Local pairing • token protected • Downloads sharing" Foreground="#789FAF" TextWrapping="Wrap" FontSize="11" Margin="4,7,4,0"/>
      </StackPanel>
     </Border>
    </Grid>
   </Grid>

   <!-- center: business mode -->
   <Grid x:Name="BusinessModeGrid" Grid.Row="1" Grid.Column="1" Margin="0,12,12,12" Visibility="Collapsed">
    <Border Style="{StaticResource Glass}" Padding="18">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
      <DockPanel>
       <StackPanel>
        <TextBlock Text="BUSINESS WORKSPACE" FontSize="25" FontWeight="Bold"/>
        <TextBlock Text="Satu platform. Semua solusi. • Ice Blue Edition" Foreground="#8EB6C6"/>
       </StackPanel>
       <Button DockPanel.Dock="Right" Content="← Back to KARIN" Click="PersonalMode_Click"/>
      </DockPanel>
      <UniformGrid Grid.Row="1" Columns="4" Margin="0,18,0,14">
       <Border Style="{StaticResource Card}" Margin="5"><StackPanel><TextBlock Text="FINANCE" Foreground="#75DFFF"/><TextBlock Text="Cash flow • GL • AP/AR" FontSize="12" Margin="0,6,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource Card}" Margin="5"><StackPanel><TextBlock Text="SALES" Foreground="#75DFFF"/><TextBlock Text="Customer • transaction" FontSize="12" Margin="0,6,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource Card}" Margin="5"><StackPanel><TextBlock Text="INVENTORY" Foreground="#75DFFF"/><TextBlock Text="Stock • warehouse" FontSize="12" Margin="0,6,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource Card}" Margin="5"><StackPanel><TextBlock Text="PURCHASING" Foreground="#75DFFF"/><TextBlock Text="PO • supplier" FontSize="12" Margin="0,6,0,0"/></StackPanel></Border>
      </UniformGrid>
      <Grid Grid.Row="2">
       <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource Card}" Margin="5">
        <StackPanel>
         <TextBlock Text="BUSINESS MODULES" Foreground="#75DFFF"/>
         <WrapPanel Margin="0,10,0,0">
          <Button Content="Finance" Click="BusinessModule_Click"/>
          <Button Content="Sales" Click="BusinessModule_Click"/>
          <Button Content="Inventory" Click="BusinessModule_Click"/>
          <Button Content="Purchasing" Click="BusinessModule_Click"/>
          <Button Content="Assets" Click="BusinessModule_Click"/>
          <Button Content="Reports" Click="BusinessModule_Click"/>
          <Button Content="Manufacturing" Click="BusinessModule_Click"/>
          <Button Content="Coretax" Click="BusinessModule_Click"/>
          <Button Content="Excel Tools" Click="BusinessModule_Click"/>
         </WrapPanel>
        </StackPanel>
       </Border>
       <Border Grid.Column="1" Style="{StaticResource Card}" Margin="5">
        <StackPanel>
         <TextBlock Text="KARIN • BUSINESS ASSISTANT" Foreground="#75DFFF"/>
         <TextBlock Text="Gunakan voice/text command untuk membuka modul, mencari dokumen, atau menyiapkan pekerjaan bisnis." TextWrapping="Wrap" Margin="0,10,0,12"/>
         <Button Content="Speak: “Karin, buka Finance”" Click="Mic_Click"/>
        </StackPanel>
       </Border>
      </Grid>
     </Grid>
    </Border>
   </Grid>

   <!-- right system status -->
   <Border Grid.Row="1" Grid.Column="2" Margin="0,12,0,12" Style="{StaticResource Glass}" Padding="16">
    <StackPanel>
     <TextBlock Text="SYSTEM STATUS" Foreground="#75DFFF" FontSize="11"/>
     <TextBlock x:Name="CpuText" Text="KARIN CPU —" Margin="0,12,0,5"/>
     <ProgressBar x:Name="CpuBar" Height="8" Maximum="100"/>
     <TextBlock x:Name="MemText" Text="KARIN MEMORY —" Margin="0,14,0,5"/>
     <ProgressBar x:Name="MemBar" Height="8" Maximum="100"/>
     <TextBlock x:Name="ProcText" Text="PROCESS —" Foreground="#97CADB" Margin="0,12,0,0"/>

     <Separator Margin="0,18"/>
     <TextBlock Text="ACTIVE CAPABILITIES" Foreground="#75DFFF" FontSize="11"/>
     <TextBlock Text="✓ App launcher" Margin="0,10,0,2"/>
     <TextBlock Text="✓ Document search" Margin="0,2"/>
     <TextBlock Text="✓ Female TTS voice selection" Margin="0,2"/>
     <TextBlock Text="✓ Wake word + spoken commands" Margin="0,2"/>
     <TextBlock Text="✓ Routine notices" Margin="0,2"/>
     <TextBlock Text="✓ Android local bridge" Margin="0,2"/>
     <TextBlock Text="✓ Business workspace" Margin="0,2"/>

     <Separator Margin="0,18"/>
     <TextBlock Text="ASSISTANT STATE" Foreground="#75DFFF" FontSize="11"/>
     <Border Style="{StaticResource Card}" Margin="0,9,0,0">
      <StackPanel>
       <TextBlock x:Name="VoiceStateText" Text="Voice engine ready" Foreground="#BFEFFF"/>
       <TextBlock Text="Female voice is preferred automatically when installed in Windows." Foreground="#789FAF" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0"/>
      </StackPanel>
     </Border>
    </StackPanel>
   </Border>

   <!-- bottom command -->
   <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource Glass}" Padding="12">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Text="ASK KARIN" Foreground="#75DFFF" FontSize="11" Margin="4,0,0,5"/>
      <TextBox x:Name="CommandBox" KeyDown="CommandBox_KeyDown"/>
     </StackPanel>
     <Button Grid.Column="1" Content="Send Command" Click="Send_Click" Margin="10,24,4,4"/>
     <Button Grid.Column="2" Content="Clear" Click="Clear_Click" Margin="4,24,4,4"/>
    </Grid>
   </Border>
  </Grid>
 </Border>
</Window>